{
  "name": "beast_mode",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "esbuild app/javascript/application.js --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:watch": "esbuild app/javascript/application.js --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets --watch"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.1.1",
    "@hotwired/stimulus": "^3.2.2",
    "@popperjs/core": "^2.11.8",
    "@rails/actioncable": "^8.0.200",
    "bootstrap": "^5.3.3",
    "cable_ready": "5.0.6",
    "debounced": "^0.0.5",
    "nouislider": "^14.6.3",
    "rough-notation": "^0.5.1",
    "slim-select": "https://github.com/leastbad/slim-select",
    "stimulus_reflex": "3.5.5",
    "wnumb": "^1.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
