#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/.."

# Foreman children inherit PATH — load RVM so bin/rails gets 3.4.10, not the default 3.1.3
if [ -s "$HOME/.rvm/scripts/rvm" ]; then
  export rvm_silence_path_mismatch_check_flag=1
  # shellcheck disable=SC1090
  . "$HOME/.rvm/scripts/rvm"
  rvm use "$(tr -d '[:space:]' < .ruby-version)" >/dev/null 2>&1
fi

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
# shellcheck disable=SC1091
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
# Quiet when the parent shell already ran `nvm use`
[ -f .nvmrc ] && nvm use --silent >/dev/null 2>&1 || true

if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

exec foreman start -f Procfile.dev "$@"
